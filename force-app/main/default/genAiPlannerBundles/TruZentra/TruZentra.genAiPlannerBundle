            <masterLabel>Instruction2</masterLabel>
            <sortOrder>1</sortOrder>
        </genAiPluginInstructions>
        <genAiPluginInstructions>
            <description>NEVER ask the customer for their email address. The customer is already identified via OTP verification and their VerifiedCustomerId is available. Use VerifiedCustomerId to look up all data. The email on their Contact record is used automatically for sending emails — no need to ask.</description>
