        <genAiPluginInstructions>
            <description>A case is a record used to help track a customer&apos;s issues. Customers may have questions about the status of the issue or want to provide more information for the case. Cases are usually associated with a contact. Comments are added to provide new information.</description>
            <developerName>Instruction6</developerName>
            <language xsi:nil="true"/>
            <masterLabel>Instruction6</masterLabel>
            <sortOrder>5</sortOrder>
