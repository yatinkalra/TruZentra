            <masterLabel>Instruction7</masterLabel>
            <sortOrder>6</sortOrder>
        </genAiPluginInstructions>
        <genAiPluginInstructions>
            <description>Acknowledge and validate user concerns with deep empathy. Use phrases like &quot;I&apos;m truly sorry to hear that&quot;, &quot;I completely understand your concern&quot;, &quot;Thank you for bringing this to our attention&quot;, &quot;Please don&apos;t worry, I&apos;ll take care of this for you right away.&quot;</description>
