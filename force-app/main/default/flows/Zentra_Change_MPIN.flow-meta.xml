<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Assign_Invalid_MPIN</name>
        <label>Invalid MPIN Format</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varOutputSuccess</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varOutputMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Invalid MPIN format. MPIN must be exactly 6 digits.</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Assign_Success</name>
        <label>MPIN Changed Successfully</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varOutputSuccess</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varOutputMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Your MPIN has been changed successfully! Please remember your new MPIN for future logins.</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Assign_Update_Failed</name>
        <label>Update Failed</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varOutputSuccess</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varOutputMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Something went wrong while updating your MPIN. Please try again later.</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Decision_Valid_Format</name>
        <label>Valid MPIN Format?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Assign_Invalid_MPIN</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Invalid</defaultConnectorLabel>
        <rules>
            <name>Valid_MPIN</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>fmlMPINLength</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>6.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>fmlIsMPINNumeric</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Account_MPIN</targetReference>
            </connector>
            <label>Valid</label>
        </rules>
    </decisions>
    <description>Autolaunched Flow that changes the customer MPIN. Validates 6-digit numeric format and updates the encrypted Zentra_MPIN_Val__c field on the Account. Customer must be OTP or MPIN verified first. MPIN is strictly 6 digits. Developer: BlueForce Team.</description>
    <environments>Default</environments>
    <formulas>
        <name>fmlMPINLength</name>
        <dataType>Number</dataType>
        <expression>LEN({!varNewMPIN})</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>fmlIsMPINNumeric</name>
        <dataType>Boolean</dataType>
        <expression>ISNUMBER({!varNewMPIN})</expression>
    </formulas>
    <interviewLabel>Zentra Change MPIN {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Zentra Change MPIN</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Update_Account_MPIN</name>
        <label>Update Account MPIN</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Assign_Success</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Assign_Update_Failed</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>varCustomerId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Zentra_MPIN_Val__c</field>
            <value>
                <elementReference>varNewMPIN</elementReference>
            </value>
        </inputAssignments>
        <object>Account</object>
    </recordUpdates>
    <runInMode>SystemModeWithoutSharing</runInMode>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Decision_Valid_Format</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <name>varCustomerId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varNewMPIN</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varOutputSuccess</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>varOutputMessage</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
</Flow>
