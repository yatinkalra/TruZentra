    <decisions>
        <name>Decision_Account_Found</name>
        <label>Account Found?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Assign_Account_Not_Found</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Found</defaultConnectorLabel>
        <rules>
            <name>Account_Exists</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Customer_Account</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Customer_Contact</targetReference>
            </connector>
            <label>Found</label>
        </rules>
    </decisions>
    <decisions>
        <name>Decision_Already_Locked</name>
        <label>Already Locked?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Decision_Expired</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Locked</defaultConnectorLabel>
        <rules>
            <name>Is_Locked</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_OTP_Session.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Locked</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Locked</targetReference>
            </connector>
            <label>Locked</label>
        </rules>
    </decisions>
    <decisions>
        <name>Decision_Expired</name>
        <label>OTP Expired?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Decision_OTP_Match</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Expired</defaultConnectorLabel>
        <rules>
            <name>Is_Expired</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_OTP_Session.Expires_At__c</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <elementReference>$Flow.CurrentDateTime</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Session_Expired</targetReference>
            </connector>
            <label>Expired</label>
        </rules>
    </decisions>
    <decisions>
        <name>Decision_Max_Attempts</name>
        <label>Max Attempts Reached?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Update_Session_Failed_Attempt</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Attempts Remaining</defaultConnectorLabel>
        <rules>
            <name>Max_Reached</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varNewAttemptCount</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>3.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Session_Locked</targetReference>
            </connector>
            <label>Max Reached</label>
        </rules>
    </decisions>
    <decisions>
        <name>Decision_OTP_Match</name>
        <label>OTP Code Match?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Increment_Attempts</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Match</defaultConnectorLabel>
        <rules>
            <name>OTP_Matches</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_OTP_Session.OTP_Code__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>varOTPCode</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Session_Verified</targetReference>
            </connector>
            <label>Match</label>
        </rules>
    </decisions>
    <decisions>
        <name>Decision_Session_Found</name>
        <label>Session Found?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Assign_No_Session</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Found</defaultConnectorLabel>
        <rules>
            <name>Session_Exists</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_OTP_Session</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Decision_Already_Locked</targetReference>
            </connector>
            <label>Found</label>
        </rules>
    </decisions>
    <description>Autolaunched Flow that verifies a 6-digit OTP code entirely in Flow (no Apex). Looks up Zentra_OTP_Session__c, checks expiry, validates code, handles attempt counting and lockout, and returns Customer Id from the session record. Developer: BlueForce Team.</description>
    <environments>Default</environments>
    <formulas>
        <name>fmlNewAttemptCount</name>
        <dataType>Number</dataType>
        <expression>{!Get_OTP_Session.Attempt_Count__c} + 1</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>fmlPhoneWithPrefix</name>
        <dataType>String</dataType>
        <expression>IF(
    LEFT({!Get_OTP_Session.Phone_Number__c}, 1) = &apos;+&apos;,
    {!Get_OTP_Session.Phone_Number__c},
    &apos;+91&apos; &amp; {!Get_OTP_Session.Phone_Number__c}
)</expression>
    </formulas>
    <formulas>
        <name>fmlRemainingAfterSuccess</name>
        <dataType>Number</dataType>
        <expression>3 - ({!Get_OTP_Session.Attempt_Count__c} + 1)</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>fmlRemainingAttempts</name>
        <dataType>Number</dataType>
        <expression>3 - {!varNewAttemptCount}</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>fmlSessionToken</name>
        <dataType>String</dataType>
        <expression>{!Get_OTP_Session.Id} &amp; &apos;-&apos; &amp; TEXT({!$Flow.CurrentDateTime})</expression>
    </formulas>
    <formulas>
        <name>fmlWrongOTPMessage</name>
        <dataType>String</dataType>
        <expression>&apos;Incorrect OTP. &apos; &amp; TEXT(3 - {!varNewAttemptCount}) &amp; &apos; attempt(s) remaining.&apos;</expression>
    </formulas>
    <interviewLabel>Zentra Verify OTP {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Zentra Verify OTP</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Customer_Account</name>
        <label>Get Customer Account by Phone</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Decision_Account_Found</targetReference>
        </connector>
        <filterLogic>or</filterLogic>
        <filters>
            <field>Phone</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_OTP_Session.Phone_Number__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Phone</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>fmlPhoneWithPrefix</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Account</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Customer_Contact</name>
        <label>Get Customer Contact</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Assign_Success</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>AccountId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Customer_Account.Id</elementReference>
